            "type" : "string",
            "enum" : [ "STATIC_WARNING", "CODE_CONTEXT", "TEST_RESULT", "FAILED_TEST", "STACK_TRACE", "COVERAGE_INFORMATION" ]
          },
          "summary" : {
            "type" : "string"
          },
          "file_path" : {
            "type" : "string"
          },
          "start_line" : {
            "type" : "integer",
