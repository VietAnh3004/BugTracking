{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Evidence-Based Program Analysis API",
    "description" : "Evidence store, phân tích tĩnh, bằng chứng kiểm thử và human review.",
    "license" : {
      "name" : "MIT"
    },
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "name" : "projects",
    "description" : "Quản lý dự án được phân tích."
  }, {
    "name" : "evidence-tools",
    "description" : "5 evidence tool mà Agent Service gọi. RPC theo tên tool, không phải REST resource — xem ADR 0005."
  } ],
  "paths" : {
    "/api/v1/tools/search_evidence" : {
      "post" : {
        "tags" : [ "evidence-tools" ],
        "operationId" : "searchEvidence",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SearchEvidenceRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SearchEvidenceResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/get_warning" : {
      "post" : {
        "tags" : [ "evidence-tools" ],
        "operationId" : "getWarning",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GetWarningRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GetWarningResult"
                }
              }
            }
          }
        }
      }
    },
