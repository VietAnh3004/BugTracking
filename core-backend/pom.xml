<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>vn.hust.datn</groupId>
  <artifactId>core-backend</artifactId>
  <version>0.1.0</version>
  <name>core-backend</name>
  <description>Evidence store, analysis orchestration and citation validation</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>2.8.6</springdoc.version>
    <spotless.version>2.44.4</spotless.version>
    <minio.version>8.5.17</minio.version>
    <commons-compress.version>1.27.1</commons-compress.version>
    <commons-io.version>2.18.0</commons-io.version>
    <!-- Phải khớp phiên bản Testcontainers ${testcontainers.version} kéo về — xem chú thích ở dependency. -->
    <docker-java.version>3.4.2</docker-java.version>
    <!-- Ghi đè bản Testcontainers mà Spring Boot 3.5.0 quản lý (1.21.0): bản đó không đọc được
         response /info của Docker Desktop 29.x trên Windows named pipe lẫn TCP (BadRequestException
         400 với body rỗng bất kể transport) — lỗi tương thích docker-java, không phải cấu hình sai. -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
        JWT qua oauth2-resource-server thay vì jjwt: ta không làm OAuth2 (không có Authorization
        Server), chỉ mượn NimbusJwtDecoder/NimbusJwtEncoder + BearerTokenAuthenticationFilter mà
        Spring khuyến nghị cho JWT tự phát. Đổi lại: validate exp/iss có sẵn qua
        OAuth2TokenValidator, 401 chuẩn RFC 6750, và springdoc tự bỏ qua tham số
        @AuthenticationPrincipal (jjwt thì phải tự viết filter + tự cấu hình springdoc).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!--
        SDK MinIO thay vì aws-sdk-v2: cấu hình 3 dòng (endpoint/credentials) thay vì
        endpointOverride + forcePathStyle + region giả cần thiết để aws-sdk-v2 nói chuyện được
        với MinIO. Rủi ro "khoá cứng vào MinIO" được triệt bằng thiết kế, không bằng chọn SDK:
        io.minio.* chỉ được import trong đúng một lớp, MinioObjectStorageClient.
    -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
      <version>${minio.version}</version>
    </dependency>

    <!--
        Điều khiển Docker daemon để chạy analyzer trong sandbox (ADR 0008).

        GHIM ĐÚNG phiên bản mà Testcontainers 1.21.4 kéo về (3.4.2), không để Spring Boot hay
        Testcontainers tự quyết: máy phát triển này đã có sẹo với đúng cặp thư viện đó —
        Testcontainers 1.21.0 (docker-java cũ hơn) nhận BadRequestException 400 với body rỗng từ
        Docker Desktop 29.x. Ghim ở một chỗ để test tích hợp và mã production KHÔNG BAO GIỜ chạy
        trên hai phiên bản khác nhau; nếu lệch, một bên xanh còn bên kia hỏng ở môi trường thật.

        transport-zerodep: không kéo theo Netty/Apache HttpClient, và là transport mà
        Testcontainers dùng — tức là transport đã được kiểm chứng trên máy này.
    -->
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-core</artifactId>
      <version>${docker-java.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-transport-zerodep</artifactId>
      <version>${docker-java.version}</version>
    </dependency>

    <!--
        Dựng tar để đẩy cây mã nguồn vào container sandbox (ADR 0008: không bind mount).

        KHÔNG tự viết một bộ ghi tar tối giản: định dạng ustar giới hạn tên 100 ký tự và cắt âm
        thầm phần thừa, mà đường dẫn Java kiểu src/main/java/vn/hust/datn/casestudy/... vượt mốc
        đó rất dễ. commons-compress tự chuyển sang PAX khi cần.
    -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>${commons-compress.version}</version>
    </dependency>
    <!--
        Nâng commons-io lên tường minh: một phụ thuộc khác kéo về 2.13.0, mà commons-compress
        1.27 gọi FileTimes.toUnixTime(FileTime) chỉ có từ 2.16. Hậu quả là NoSuchMethodError LÚC
        CHẠY, không phải lúc biên dịch — và chỉ nổ ở đúng nhánh code chạm tới thời gian của entry
        tar, nên hoàn toàn có thể lọt qua một phần bộ test rồi mới lộ ra.
    -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>${commons-io.version}</version>
    </dependency>

    <!-- Migration: schema chỉ thay đổi qua Flyway, ddl-auto luôn là 'validate'. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenAPI spec là hợp đồng API; frontend sinh client TypeScript từ đây. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Postgres thật trong integration test: pgvector và JSONB không mock được bằng H2. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Chỉ dùng trong đúng một test JUnit thuần (MinioObjectStorageClientTest) - xem Javadoc lớp
         đó về lý do KHÔNG đưa MinIO vào AbstractIntegrationTest dùng chung. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>minio</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
            <!-- Bắt buộc khi dùng chung Lombok + MapStruct: thiếu path này, MapStruct có thể chạy
                 trước khi Lombok sinh getter/setter và lặng lẽ sinh ra mapper implementation RỖNG
                 (biên dịch thành công, DTO toàn null, không báo lỗi gì). -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>0.2.0</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-parameters</arg>
            <arg>-Amapstruct.defaultComponentModel=spring</arg>
            <!-- Field nguồn/đích không map được phải là lỗi biên dịch, không phải cảnh báo im lặng. -->
            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!--
                Format tự động. `mvn spotless:apply` để sửa, CI chạy `spotless:check`.

                Không dùng palantir-java-format / google-java-format: cả hai gọi API nội bộ của
                javac nên vỡ trên JDK mới (đã thử, hỏng trên JDK 25). Các bước dưới đây chạy trên
                JavaParser nên độc lập với phiên bản JDK.
            -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <removeUnusedImports>
              <engine>cleanthat-javaparser-unnecessaryimport</engine>
            </removeUnusedImports>
            <importOrder>
              <order>java,javax,jakarta,org,com,vn.hust.datn,</order>
            </importOrder>
            <formatAnnotations/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
