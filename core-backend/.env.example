# Biến môi trường của core-backend khi chạy đơn lẻ (ngoài docker-compose).
# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.

# ---------- Bắt buộc: thiếu thì ứng dụng không khởi động ----------
DB_URL=jdbc:postgresql://localhost:5432/evidence_agent
DB_USER=evidence
DB_PASSWORD=change-me-local-only

# Origin của frontend, phân tách bằng dấu phẩy. Phải khớp chính xác scheme + host + port.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-secret

# Bí mật chia sẻ cho agent-service gọi /api/v1/tools/** qua header X-Service-Token — KHÔNG dùng
# JWT cho việc này (ADR 0005). Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
SERVICE_TOKEN=change-me-at-least-32-characters-long-secret

AGENT_SERVICE_URL=http://localhost:8000

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=change-me-local-only
STORAGE_BUCKET=repositories

# ---------- Tuỳ chọn: có giá trị mặc định ----------
# SERVER_PORT=8080
# DB_POOL_SIZE=10
# JWT_EXPIRATION=PT15M
# JWT_REFRESH_EXPIRATION=P14D
# JWT_ISSUER=datn-hust-evidence-agent
# BCRYPT_STRENGTH=10
# AGENT_TIMEOUT=PT120S
# MAX_UPLOAD_SIZE=100MB
# LOG_LEVEL=INFO
# Giới hạn chống zip-bomb khi giải nén snapshot (byte thô của multipart request đã bị chặn riêng
# bởi MAX_UPLOAD_SIZE ở trên — các biến dưới đây chặn dựa trên nội dung SAU khi giải nén).
# UPLOAD_MAX_FILES=20000
# UPLOAD_MAX_UNCOMPRESSED_BYTES=524288000
# UPLOAD_MAX_COMPRESSION_RATIO=200
# UPLOAD_MAX_STORED_FILE_BYTES=2097152
