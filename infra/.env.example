# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
#   cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_DB=evidence_agent
POSTGRES_USER=evidence
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# ---------- Object storage (MinIO) ----------
# MinIO TỪ CHỐI KHỞI ĐỘNG nếu user < 3 ký tự hoặc password < 8 ký tự, và nó thoát ngay với
# exit code 1 — `docker compose up -d` vẫn báo "Started" nên rất dễ tưởng là chạy được, chỉ tới
# lúc backend gọi tới mới thấy Connection refused. Kiểm bằng `docker logs evidence-agent-minio-1`.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BUCKET=repositories

# ---------- core-backend ----------
CORE_BACKEND_PORT=8080
# Danh sách origin của frontend, phân tách bằng dấu phẩy.
# Phải khớp CHÍNH XÁC scheme + host + port trình duyệt đang dùng.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-secret
# Bí mật chia sẻ cho agent-service gọi /api/v1/tools/** qua header X-Service-Token (ADR 0005).
# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
SERVICE_TOKEN=change-me-at-least-32-characters-long-secret

# Chạy analyzer trong Docker sandbox. Biến dưới đây để trống = TẮT (core-backend trả 503 khi bấm
# "Phân tích tự động"). Bật trên máy dev:
#   1. ./infra/analyzer/build.sh          (dựng hai image, tự đối chiếu, hỏng thì dừng)
#   2. đặt ANALYSIS_RUNNER=docker ở đây
# LƯU Ý: docker-compose.yml hiện mount SẴN /var/run/docker.sock vào core-backend (không còn để
# comment), nên quyền root trên máy chủ đã được cấp kể cả khi biến này tắt. Muốn tắt hẳn thì
# comment khối mount trong docker-compose.yml. Xem infra/README.md và ADR 0008.
# Trên VPS KHÔNG dùng file này — xem .env.vps.example và docs/deploy-vps.md.
# ANALYSIS_RUNNER=docker

# ---------- Tài khoản: email xác thực / quên mật khẩu, đăng nhập Google ----------
# URL frontend mà NGƯỜI DÙNG mở — link trong email trỏ về đây (không phải hostname docker).
APP_PUBLIC_URL=http://localhost:3000
# Gửi mail qua Gmail SMTP. MAIL_PASSWORD là App Password 16 ký tự, KHÔNG phải mật khẩu Gmail:
# bật xác minh 2 bước rồi tạo ở https://myaccount.google.com/apppasswords
# Để trống MAIL_USERNAME thì KHÔNG gửi thư — nội dung thư (kèm link) chỉ được ghi vào log của
# core-backend, đủ để thử trên máy dev.
#
# Muốn thử gửi từ tên miền thật (Resend) ngay trên máy dev: đặt MAIL_HOST=smtp.resend.com,
# MAIL_USERNAME=resend, MAIL_PASSWORD=<API key>, MAIL_FROM=no-reply@vsleuth.id.vn — xem docs/email.md.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Người gửi; để trống = MAIL_USERNAME. Với Gmail, địa chỉ PHẢI là chính tài khoản Gmail (hoặc
# một alias đã thêm trong Gmail > Cài đặt > "Gửi thư bằng địa chỉ") — địa chỉ khác bị Gmail thay
# bằng tài khoản đăng nhập. Tên hiển thị thì đặt tuỳ ý.
# MAIL_FROM=
# Tên hiện ở ô "Từ" trong hộp thư người nhận (có dấu được), và trên đầu/chân thư HTML.
MAIL_FROM_NAME=VSleuth
# OAuth Client ID (loại "Web application") tạo ở https://console.cloud.google.com/apis/credentials
# — khai APP_PUBLIC_URL (và http://localhost:5173 khi chạy vite dev) vào "Authorized JavaScript
# origins". Client ID là thông tin công khai, không cần Client Secret. Để trống = ẩn nút Google.
GOOGLE_CLIENT_ID=

# ---------- Tài khoản quản trị (trang /admin) ----------
# MỘT tài khoản admin duy nhất, đăng nhập ở /admin/login bằng đúng hai giá trị này. Tên đăng nhập
# không cần là email. Mật khẩu tối thiểu 8 ký tự — trên VPS dùng chuỗi ngẫu nhiên dài
# (openssl rand -base64 24). Để trống CẢ HAI = không có admin. Đổi giá trị rồi khởi động lại
# core-backend là có hiệu lực: mật khẩu mới được băm lại và mọi phiên cũ của admin bị thu hồi.
# KHÔNG commit giá trị thật; file .env / .env.vps bị gitignore chặn.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- agent-service ----------
AGENT_SERVICE_PORT=8000
# agent-service dùng chung SERVICE_TOKEN khai ở trên — docker-compose truyền sang, không khai lại.
#
# anthropic = gọi model Claude thật (cần LLM_API_KEY)
# openai    = mọi API tương thích OpenAI, chọn nơi gọi bằng LLM_BASE_URL. Ví dụ Google Gemini:
#               LLM_PROVIDER=openai
#               LLM_API_KEY=<khoá lấy ở Google AI Studio>
#               LLM_MODEL=gemini-3.8-flash
#               LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#             Ollama trên máy: LLM_BASE_URL=http://host.docker.internal:11434/v1
# scripted  = provider giả trả kịch bản định sẵn; toàn bộ đường đi frontend → core-backend →
#             agent-service chạy THẬT, chỉ riêng model là giả. Dùng để nghiệm thu và cho CI.
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-put-your-key-here
LLM_MODEL=claude-sonnet-5
# Chỉ provider openai đọc; bỏ trống = gọi chính OpenAI.
LLM_BASE_URL=
# Số lần tự thử lại khi gặp 429/5xx. Gói free (Gemini…) hay trả 503 "high demand" theo đợt:
# đặt 6 để một lượt hỏi 5-9 vòng gọi không hỏng vì một cơn quá tải ngắn. Mặc định 2.
# LLM_MAX_RETRIES=6

# Tìm bằng chứng THEO NGHĨA cho tool search_evidence (vector embedding). none = tắt: tìm kiếm chỉ
# so chữ, và màn hình cảnh báo ghi rõ lý do. gemini = dùng gemini-embedding-001 (768 chiều), sinh
# vector ngay sau mỗi lần phân tích (~2 lượt gọi cho vulnshop) và 1 lượt cho mỗi lần Agent tìm.
# EMBEDDING_API_KEY bỏ trống thì dùng chung LLM_API_KEY (cùng một key Gemini).
EMBEDDING_PROVIDER=none
# EMBEDDING_API_KEY=
# ĐỪNG đặt LLM_TEMPERATURE: các model từ Claude Opus 4.7 trở đi trả lời 400 cho tham số này,
# nên đặt vào là mọi request đều hỏng. Xem agent-service/.env.example.
# Ghi vào llm_trace.prompt_version; tăng mỗi lần đổi prompt.
PROMPT_VERSION=v1

# ---------- frontend ----------
FRONTEND_PORT=3000
# URL trình duyệt gọi tới core-backend. Khi deploy tách server, đổi thành
# domain thật của backend — KHÔNG cần build lại image frontend.
API_BASE_URL=http://localhost:8080
