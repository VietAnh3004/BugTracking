# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
#   cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_DB=evidence_agent
POSTGRES_USER=evidence
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# ---------- Object storage (MinIO) ----------
# MinIO TỪ CHỐI KHỞI ĐỘNG nếu user < 3 ký tự hoặc password < 8 ký tự, và nó thoát ngay với
# exit code 1 — `docker compose up -d` vẫn báo "Started" nên rất dễ tưởng là chạy được, chỉ tới
# lúc backend gọi tới mới thấy Connection refused. Kiểm bằng `docker logs evidence-agent-minio-1`.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BUCKET=repositories

# ---------- core-backend ----------
CORE_BACKEND_PORT=8080
# Danh sách origin của frontend, phân tách bằng dấu phẩy.
# Phải khớp CHÍNH XÁC scheme + host + port trình duyệt đang dùng.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-secret
# Bí mật chia sẻ cho agent-service gọi /api/v1/tools/** qua header X-Service-Token (ADR 0005).
# Tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
SERVICE_TOKEN=change-me-at-least-32-characters-long-secret

# Chạy analyzer trong Docker sandbox — MẶC ĐỊNH TẮT, và đó là chủ đích.
# Bật cần HAI bước, bước thứ hai là một quyết định vận hành có ý thức:
#   1. ./infra/analyzer/build.sh          (dựng hai image, tự đối chiếu, hỏng thì dừng)
#   2. đặt ANALYSIS_RUNNER=docker Ở ĐÂY, rồi GỠ COMMENT dòng mount /var/run/docker.sock
#      trong docker-compose.yml
# Mount socket đó = cấp quyền root trên máy chủ. Xem infra/README.md và ADR 0008.
# ANALYSIS_RUNNER=docker

# ---------- agent-service ----------
AGENT_SERVICE_PORT=8000
# agent-service dùng chung SERVICE_TOKEN khai ở trên — docker-compose truyền sang, không khai lại.
#
# anthropic = gọi model thật (cần LLM_API_KEY)
# scripted  = provider giả trả kịch bản định sẵn; toàn bộ đường đi frontend → core-backend →
#             agent-service chạy THẬT, chỉ riêng model là giả. Dùng để nghiệm thu và cho CI.
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-put-your-key-here
LLM_MODEL=claude-sonnet-5
# ĐỪNG đặt LLM_TEMPERATURE: các model từ Claude Opus 4.7 trở đi trả lời 400 cho tham số này,
# nên đặt vào là mọi request đều hỏng. Xem agent-service/.env.example.
# Ghi vào llm_trace.prompt_version; tăng mỗi lần đổi prompt.
PROMPT_VERSION=v1

# ---------- frontend ----------
FRONTEND_PORT=3000
# URL trình duyệt gọi tới core-backend. Khi deploy tách server, đổi thành
# domain thật của backend — KHÔNG cần build lại image frontend.
API_BASE_URL=http://localhost:8080
