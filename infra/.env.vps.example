# Cấu hình cho VPS. Hướng dẫn: docs/deploy-vps.md
#
#   cp infra/.env.vps.example infra/.env.vps   && chmod 600 infra/.env.vps
#
# KHÔNG commit infra/.env.vps — .gitignore chặn qua luật `.env.*`; chỉ file .example này được commit.
# Mọi dòng "change-me" PHẢI thay. Sinh chuỗi ngẫu nhiên bằng: openssl rand -base64 48
# Đừng dùng lại giá trị nào từ .env của máy dev — kể cả khi "chép sang cho nhanh": trùng
# JWT_SECRET thì ai có .env của máy dev cũng tự ký được token đăng nhập hợp lệ trên VPS, trùng
# SERVICE_TOKEN thì gọi thẳng được /api/v1/tools/**. (Đã xảy ra thật 18/11/2026, đã sinh lại.)

# ---------- Tên miền ----------
# Tên miền frontend và backend — đổi tên miền thì sửa CẢ BA dòng dưới, cùng server_name trong
# infra/vps/nginx-vsleuth.conf. Luôn https, không có dấu / ở cuối.
APP_PUBLIC_URL=https://vsleuth.id.vn
CORS_ORIGINS=https://vsleuth.id.vn
API_BASE_URL=https://api.vsleuth.id.vn

# ---------- PostgreSQL ----------
POSTGRES_DB=evidence_agent
POSTGRES_USER=evidence
POSTGRES_PASSWORD=change-me

# ---------- MinIO ----------
# User >= 3 ký tự, password >= 8 ký tự, nếu không MinIO thoát ngay mà compose vẫn báo "Started".
MINIO_ROOT_USER=vsleuth-storage
MINIO_ROOT_PASSWORD=change-me
STORAGE_BUCKET=repositories

# ---------- Bí mật của core-backend ----------
# Tối thiểu 32 ký tự mỗi cái, và HAI GIÁ TRỊ KHÁC NHAU.
JWT_SECRET=change-me
SERVICE_TOKEN=change-me

# ---------- Docker sandbox (TẮT mặc định, chỉ bật lúc demo — docs/deploy-vps.md mục 9) ----------
# Chỉ đọc khi ghép thêm infra/docker-compose.vps.sandbox.yml; thiếu thì lệnh BẬT dừng ngay.
# gid của nhóm sở hữu Docker socket trên VPS. Lấy bằng:  stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=change-me
# Mỗi lần phân tích chiếm tối đa chừng này RAM/CPU, chạy tuần tự. VPS 8 GB thì giữ mặc định.
# SANDBOX_MEMORY_BYTES=2147483648
# SANDBOX_CPUS=2

# ---------- Email (xác thực tài khoản, quên mật khẩu) — qua Resend, xem docs/email.md ----------
# Để trống MAIL_USERNAME = không gửi thư thật, link chỉ ghi vào log. Trên VPS thật PHẢI điền:
# người dùng không đọc được log của server.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
# Với Resend, tên đăng nhập SMTP là đúng chữ "resend"; mật khẩu là API key (re_...).
MAIL_USERNAME=resend
MAIL_PASSWORD=change-me
# BẮT BUỘC với Resend (tên đăng nhập không phải địa chỉ email). Phải thuộc tên miền ĐÃ XÁC MINH
# trên Resend, nếu không Resend từ chối gửi.
MAIL_FROM=no-reply@vsleuth.id.vn
MAIL_FROM_NAME=VSleuth

# ---------- Đăng nhập Google (tuỳ chọn) ----------
# Thêm https://vsleuth.id.vn vào "Authorized JavaScript origins" của Client ID. Trống = ẩn nút.
GOOGLE_CLIENT_ID=

# ---------- Tài khoản quản trị (trang /admin) ----------
# MỘT tài khoản admin duy nhất, đăng nhập ở /admin/login bằng đúng hai giá trị này. Tên đăng nhập
# không cần là email. Mật khẩu tối thiểu 8 ký tự — trên VPS dùng chuỗi ngẫu nhiên dài
# (openssl rand -base64 24). Để trống CẢ HAI = không có admin. Đổi giá trị rồi khởi động lại
# core-backend là có hiệu lực: mật khẩu mới được băm lại và mọi phiên cũ của admin bị thu hồi.
# KHÔNG commit giá trị thật; file .env / .env.vps bị gitignore chặn.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- agent-service ----------
# Mặc định: Gemini qua API tương thích OpenAI, giống máy dev. Provider khác: xem infra/.env.example.
# ĐỪNG đặt LLM_TEMPERATURE (CLAUDE.md giải thích vì sao).
LLM_PROVIDER=openai
# Hạn mức Gemini tính theo PROJECT Google Cloud, KHÔNG theo key: key mới trong CÙNG project với
# máy dev vẫn chung hạn mức. Cho VPS: "Create API key in new project", và cân nhắc bật billing
# riêng cho project đó trước buổi demo để khỏi hết lượt giữa buổi.
LLM_API_KEY=change-me
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MAX_RETRIES=6
EMBEDDING_PROVIDER=none
# EMBEDDING_API_KEY=
PROMPT_VERSION=v1
