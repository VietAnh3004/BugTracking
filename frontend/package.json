{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "test": "vitest run",
    "api:generate": "openapi-typescript http://localhost:8080/api/v1/openapi -o src/shared/lib/api-types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.0",
    "vite": "^8.1.1",
    "vitest": "^3.0.5"
  }
}
