# Biến môi trường của agent-service. Copy sang .env rồi điền giá trị thật.
# KHÔNG commit .env — file này chứa khoá API.

# ---------- Bắt buộc: thiếu thì service không khởi động ----------
CORE_API_URL=http://localhost:8080
# Bí mật chia sẻ với core-backend cho header X-Service-Token. Phải TRÙNG với biến SERVICE_TOKEN
# của core-backend, và KHÔNG phải JWT người dùng (ADR 0005 điểm 2).
SERVICE_TOKEN=doi-gia-tri-nay-truoc-khi-chay

# anthropic | scripted   (openai, ollama là việc của tuần 15)
# scripted = provider giả trả kịch bản định sẵn: chạy được toàn bộ đường đi end-to-end
# frontend -> core-backend -> agent-service mà không cần khoá API thật.
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-put-your-key-here
LLM_MODEL=claude-sonnet-5

# ---------- Tuỳ chọn: có giá trị mặc định ----------
# KHÔNG đặt LLM_TEMPERATURE với provider anthropic. Các model từ Claude Opus 4.7 trở đi (gồm cả
# claude-sonnet-5 ở trên) trả lời 400 cho tham số này, nên đặt vào là mọi request đều hỏng.
# AnthropicProvider nổ ngay lúc khởi động nếu thấy biến này, thay vì để hỏng giữa hội thoại.
# Độ ổn định giữa các lần chạy được báo cáo bằng cách chạy lặp rồi đo phương sai (kế hoạch §6).
# LLM_TEMPERATURE=

# LLM_MAX_TOKENS=8192
# MAX_TOOL_ITERATIONS=8
# Số ký tự kết quả tool tối đa nhồi vào ngữ cảnh MỘT lượt hỏi. Vượt thì bị cắt, và phần cắt
# được nói rõ cho model. Một cảnh báo của vulnshop có tới 52 liên kết CONTRADICTS.
# EVIDENCE_CONTEXT_BUDGET=12000
# Ghi vào llm_trace.prompt_version. Đổi prompt thì tăng số này, nếu không kết quả thực nghiệm
# của hai phiên bản prompt sẽ nằm lẫn vào nhau và không tách lại được.
# PROMPT_VERSION=v1
# REQUEST_TIMEOUT_SECONDS=120
# LOG_LEVEL=INFO
