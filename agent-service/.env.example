# Biến môi trường của agent-service. Copy sang .env rồi điền giá trị thật.
# KHÔNG commit .env — file này chứa khoá API.

# ---------- Bắt buộc: thiếu thì service không khởi động ----------
CORE_API_URL=http://localhost:8080

# anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-put-your-key-here
LLM_MODEL=claude-sonnet-5

# ---------- Tuỳ chọn: có giá trị mặc định ----------
# Để 0.0 khi chạy thực nghiệm: kết quả bớt dao động giữa các lần chạy.
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096
# MAX_TOOL_ITERATIONS=8
# EVIDENCE_CONTEXT_BUDGET=12000
# REQUEST_TIMEOUT_SECONDS=120
# LOG_LEVEL=INFO
