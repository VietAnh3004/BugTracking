# Biến môi trường của agent-service. Copy sang .env rồi điền giá trị thật.
# KHÔNG commit .env — file này chứa khoá API.

# ---------- Bắt buộc: thiếu thì service không khởi động ----------
CORE_API_URL=http://localhost:8080
# Bí mật chia sẻ với core-backend cho header X-Service-Token. Phải TRÙNG với biến SERVICE_TOKEN
# của core-backend, và KHÔNG phải JWT người dùng (ADR 0005 điểm 2).
SERVICE_TOKEN=doi-gia-tri-nay-truoc-khi-chay

# anthropic | openai | scripted
# openai   = mọi API tương thích OpenAI (Gemini, Groq, OpenRouter, Ollama…), chọn bằng
#            LLM_BASE_URL. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# scripted = provider giả trả kịch bản định sẵn: chạy được toàn bộ đường đi end-to-end
# frontend -> core-backend -> agent-service mà không cần khoá API thật.
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-put-your-key-here
LLM_MODEL=claude-sonnet-5

# Model PREMIUM cho dự án được admin nâng hạng (core-backend gửi model_tier=premium). Cùng định dạng
# với LLM_*. Để trống khoá = tier premium tắt (hỏi Premium báo lỗi, không rơi về model free).
# PREMIUM_LLM_PROVIDER=anthropic
# PREMIUM_LLM_API_KEY=
# PREMIUM_LLM_MODEL=claude-sonnet-5
# PREMIUM_LLM_BASE_URL=
# Chỉ provider openai đọc; bỏ trống = gọi chính OpenAI.
LLM_BASE_URL=
# Số lần tự thử lại khi gặp 429/5xx. Gói free (Gemini…) hay trả 503 "high demand" theo đợt:
# đặt 6 để một lượt hỏi 5-9 vòng gọi không hỏng vì một cơn quá tải ngắn. Mặc định 2.
# LLM_MAX_RETRIES=6

# Tìm bằng chứng THEO NGHĨA cho tool search_evidence (vector embedding). none = tắt: tìm kiếm chỉ
# so chữ, và màn hình cảnh báo ghi rõ lý do. gemini = dùng gemini-embedding-001 (768 chiều), sinh
# vector ngay sau mỗi lần phân tích (~2 lượt gọi cho vulnshop) và 1 lượt cho mỗi lần Agent tìm.
# EMBEDDING_API_KEY bỏ trống thì dùng chung LLM_API_KEY (cùng một key Gemini).
EMBEDDING_PROVIDER=none
# EMBEDDING_API_KEY=
# Bản free giới hạn 100 đoạn văn bản/phút: gặp 429 thì chờ đúng thời gian Google yêu cầu rồi gửi
# lại, tổng thời gian chờ tối đa như dưới (giây). Run 124 bằng chứng cần chờ khoảng 1 phút.
# EMBEDDING_RETRY_MAX_WAIT_SECONDS=150
# EMBEDDING_QUERY_MAX_WAIT_SECONDS=10

# ---------- Tuỳ chọn: có giá trị mặc định ----------
# KHÔNG đặt LLM_TEMPERATURE với provider anthropic. Các model từ Claude Opus 4.7 trở đi (gồm cả
# claude-sonnet-5 ở trên) trả lời 400 cho tham số này, nên đặt vào là mọi request đều hỏng.
# AnthropicProvider nổ ngay lúc khởi động nếu thấy biến này, thay vì để hỏng giữa hội thoại.
# Độ ổn định giữa các lần chạy được báo cáo bằng cách chạy lặp rồi đo phương sai (kế hoạch §6).
# LLM_TEMPERATURE=

# LLM_MAX_TOKENS=8192
# MAX_TOOL_ITERATIONS=8
# Số ký tự kết quả tool tối đa nhồi vào ngữ cảnh MỘT lượt hỏi. Vượt thì bị cắt, và phần cắt
# được nói rõ cho model. Một cảnh báo của vulnshop có tới 52 liên kết CONTRADICTS.
# EVIDENCE_CONTEXT_BUDGET=12000
# Ghi vào llm_trace.prompt_version. Đổi prompt thì tăng số này, nếu không kết quả thực nghiệm
# của hai phiên bản prompt sẽ nằm lẫn vào nhau và không tách lại được.
# PROMPT_VERSION=v2
# REQUEST_TIMEOUT_SECONDS=120
# LOG_LEVEL=INFO
